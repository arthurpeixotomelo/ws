{
  "guard-shell": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin C:/Users/arthu/.gemini/config/scripts/guard-shell.nu",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "linter": {
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "nu --stdin C:/Users/arthu/.gemini/config/scripts/lint-fix.nu",
            "timeout": 30
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "nu --stdin C:/Users/arthu/.gemini/config/scripts/lint-check.nu",
        "timeout": 60
      }
    ]
  }
}
